PACKAGE_NAME="aufs-ng"
PACKAGE_VERSION="#MODULE_VERSION#"

BUILT_MODULE_NAME[0]="aufs-ng"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"

MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build CONFIG_AUFSNG_FS=m modules"

BUILD_EXCLUSIVE_KERNEL_MIN="6.12"
BUILD_EXCLUSIVE_CONFIG="CONFIG_64BIT CONFIG_FS_STACK"
AUTOINSTALL="yes"
